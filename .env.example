VITE_SUPABASE_URL=https://viaeglmpkyfaxjodepgi.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# /admin : connexion avec un compte Supabase Auth déclaré dans la table blog_admins
# (voir supabase/blog_posts.sql).

# Agent IA : dépôt proposé par défaut pour un nouveau script
VITE_AGENT_DEFAULT_REPO=Hassyunity/porttfolio-2026
# Nom de l Edge Function de l agent tel que déployé dans Supabase (agent-dispatch par défaut)
VITE_AGENT_FUNCTION=agent-dispatch

# Altea : empreinte SHA-256 du mot de passe d'accès (jamais le mot de passe en clair :
# tout ce qui commence par VITE_ est lisible dans le code envoyé au navigateur).
# Pour la calculer : printf %s 'mot-de-passe' | sha256sum
VITE_ALTEA_PASSWORD_SHA256=
# Domaine des sites clients, ex. altea.fr (vide = adresses /sites/<nom> du portfolio)
VITE_ALTEA_DOMAIN=
